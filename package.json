{
  "name": "piclite",
  "version": "0.13.4",
  "description": "面向内容创作者和开发者的本地优先跨平台媒体优化器",
  "author": {
    "name": "PicLite contributors",
    "email": "amiaoapp@users.noreply.github.com"
  },
  "homepage": "https://github.com/amiaoapp/PicLite",
  "repository": {
    "type": "git",
    "url": "https://github.com/amiaoapp/PicLite.git"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "test": "npm run desktop:renderer && cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint desktop vite.desktop.config.ts --ignore-pattern desktop-dist",
    "db:generate": "drizzle-kit generate",
    "desktop:dev": "tauri dev",
    "desktop:renderer:dev": "vite --config vite.desktop.config.ts",
    "desktop:renderer": "vite build --config vite.desktop.config.ts",
    "desktop:build": "tauri build",
    "desktop:build:win": "tauri build --target x86_64-pc-windows-msvc",
    "desktop:build:win:arm64": "tauri build --target aarch64-pc-windows-msvc",
    "desktop:build:mac:arm64": "tauri build --target aarch64-apple-darwin",
    "desktop:build:mac:x64": "tauri build --target x86_64-apple-darwin",
    "desktop:build:linux:arm64": "tauri build --target aarch64-unknown-linux-gnu",
    "desktop:build:linux:x64": "tauri build --target x86_64-unknown-linux-gnu"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
