{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PicLite",
  "version": "0.13.4",
  "identifier": "com.piclite.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:renderer:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run desktop:renderer",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "PicLite Batch Optimiser",
        "width": 920,
        "height": 620,
        "minWidth": 700,
        "minHeight": 460,
        "resizable": true,
        "fullscreen": false,
        "skipTaskbar": true,
        "theme": "Light",
        "backgroundColor": "#e9eeea"
      },
      {
        "label": "dropzone",
        "title": "PicLite Results",
        "url": "index.html?window=dropzone",
        "width": 420,
        "height": 320,
        "minWidth": 300,
        "minHeight": 180,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "shadow": false,
        "transparent": true,
        "backgroundColor": "#00000000"
      },
      {
        "label": "corner-drop-target",
        "title": "Drop to optimise",
        "url": "index.html?window=corner-drop-target",
        "width": 96,
        "height": 96,
        "minWidth": 64,
        "minHeight": 64,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "shadow": false,
        "transparent": true,
        "backgroundColor": "#00000000"
      },
      {
        "label": "preferences",
        "title": "PicLite Settings",
        "url": "index.html?window=preferences",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "visible": false,
        "resizable": true,
        "skipTaskbar": true,
        "theme": "Light",
        "backgroundColor": "#e9eeea"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "本地优先的跨平台媒体优化器",
    "longDescription": "PicLite 在本机自动优化图片，提供剪贴板监测、文件夹监测、全局拖放区、悬浮结果和批量处理。",
    "copyright": "Copyright © PicLite contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
